# 有内鬼 · 本地开发环境变量示例
# 复制本文件为 .env，填入真实值

# ========== 服务配置 ==========
PORT=3000
# 前端访问的基础域名，OAuth 回调需要
APP_URL=http://localhost:3000

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Session ==========
SESSION_SECRET=change_me_to_a_random_string

# ========== GitHub OAuth ==========
# 申请地址：https://github.com/settings/developers → New OAuth App
# Callback URL 必须与 APP_URL 拼接：${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ========== 微博 OAuth ==========
# 申请地址：https://open.weibo.com → 创建应用 → 高级 → OAuth2.0 授权设置
# Callback URL：${APP_URL}/auth/weibo/callback
WEIBO_CLIENT_ID=your_weibo_client_id
WEIBO_CLIENT_SECRET=your_weibo_client_secret
