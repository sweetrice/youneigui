# 有内鬼 · 本地开发环境变量示例
# 复制本文件为 .env，填入真实值

# ========== 服务配置 ==========
PORT=3000
# 前端访问的基础域名，OAuth 回调需要
APP_URL=http://localhost:3000

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Session ==========
SESSION_SECRET=change_me_to_a_random_string

# ========== GitHub OAuth ==========
# 申请地址：https://github.com/settings/developers → New OAuth App
# Callback URL 必须与 APP_URL 拼接：${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ========== 媒体文件存储 ==========
# 本地文件系统路径（零外部依赖）
# 文件自动随房间销毁清理，聊天记录只存元数据
MEDIA_STORAGE_ROOT=/data/youneigui-media
# 单房间媒体总大小上限（字节），默认 50MB，设 0 表示不限制
MEDIA_MAX_ROOM_BYTES=52428800
